# Pham Thanh Tung - MSSV: 20522132 - Muc dich: Thi nghiem 2 - Ma nguon 5 – phan bac dien nang
.data
prompt: .asciiz "Nhap dien nang (kWh): "
msg:    .asciiz "Bac: "
nl:     .asciiz "\n"
 
.text
.globl main
main:
  li  $v0, 4
  la  $a0, prompt
  syscall
  li  $v0, 5            # doc kWh, ket qua o $v0
  syscall
  add $s0, $v0, $zero   # $s0 = dien nang (kWh)
  # >>> xac dinh bac (1..4) theo Bang 6, dat vao $s1
  # Bac 1: 0 - 100
  slti $t0, $s0, 101
  bne  $t0, $zero, Bac1
  # Bac 2: 101 - 150
  slti $t0, $s0, 151
  bne  $t0, $zero, Bac2 
  # Bac 3: 151 - 200
  slti $t0, $s0, 201
  bne  $t0, $zero, Bac3  
  # Bac 4: tu 201 tro len
  li $s1, 4
  j InKetQua
  # >>> in “Bac: “, roi $s1, roi xuong dong
Bac1:
  li $s1, 1
  j InKetQua
Bac2:
  li $s1, 2
  j InKetQua
Bac3:
  li $s1, 3
InKetQua:
  li  $v0, 4
  la  $a0, msg
  syscall  
  li  $v0, 1
  add $a0, $s1, $zero
  syscall
  li  $v0, 4
  la  $a0, nl
  syscall  
  
  li  $v0, 10
  syscall